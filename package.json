{
  "name": "sticky-scroll-trigger",
  "version": "0.14.0",
  "description": "A ScrollTrigger helper that uses native CSS position:sticky instead of GSAP pinning",
  "license": "MIT",
  "author": "Kuninori Ogino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuninori-ogino/sticky-scroll-trigger.git"
  },
  "homepage": "https://github.com/kuninori-ogino/sticky-scroll-trigger",
  "keywords": [
    "gsap",
    "scrolltrigger",
    "sticky",
    "scroll",
    "pin"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/StickyScrollTrigger.js",
  "module": "./dist/StickyScrollTrigger.js",
  "types": "./dist/StickyScrollTrigger.d.ts",
  "exports": {
    ".": {
      "types": "./dist/StickyScrollTrigger.d.ts",
      "import": "./dist/StickyScrollTrigger.js",
      "default": "./dist/StickyScrollTrigger.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build --config demo/vite.config.ts",
    "build:lib": "vite build --config vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "dev:e2e": "vite --config e2e/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p demo/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier --write \"**/*.md\" \"**/*.{json,css}\"",
    "format:check": "eslint . && prettier --check \"**/*.md\" \"**/*.{json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright:install": "playwright install chromium webkit firefox",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build:lib"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "@playwright/test": "^1.64.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "gsap": "3.15.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "gsap": "^3.15.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "eslint --fix",
    "*.{md,json,css}": "prettier --write"
  }
}
